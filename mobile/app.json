{
  "expo": {
    "name": "KIRI",
    "slug": "kiri",
    "scheme": "kiri",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kiri.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.kiri.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "KIRI usa la cámara para reconocer objetos y enseñarte su nombre en el idioma que aprendes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KIRI necesita tus fotos para que puedas analizar imágenes que ya tienes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
